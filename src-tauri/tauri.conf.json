{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "first-person-3d-prototype",
  "version": "0.1.0",
  "identifier": "com.firstperson3dprototype.desktop",
  "build": {
    "frontendDist": "../frontend",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "First-Person 3D Prototype",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
